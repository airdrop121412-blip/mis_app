# Copy to .env locally; on Railway set these as service Variables instead.
# NEVER commit real values. Generate APP_KEY with: php artisan key:generate --show
APP_NAME="MIS Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT:-3306}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Frontend origin for Sanctum SPA cookies (your deployed frontend URL)
SANCTUM_STATEFUL_DOMAINS=YOUR-FRONTEND-DOMAIN
SESSION_DOMAIN=
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN
